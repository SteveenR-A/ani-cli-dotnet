<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="360"
             x:Class="AniCS.Android.Views.MobileVideoPlayerView"
             Background="Black">

    <Grid>
        <!-- 1. Native Android Video View Container -->
        <Panel Name="PlayerHostContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1" />

        <!-- 2. Touch Layer to Toggle Controls (HitTestable) -->
        <Panel Name="ClickLayer" Background="#01000000" PointerPressed="OnVideoAreaTapped" ZIndex="2" IsVisible="False" />

        <!-- 3. Central Toast Feedback OSD -->
        <Border Name="OsdToastPanel"
                IsVisible="False"
                ZIndex="15"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#DD000000" CornerRadius="12" Padding="20,10">
            <TextBlock Name="OsdToastText"
                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- 4. Fullscreen OSD Overlay Layer (Handled Natively) -->
        <Grid Name="OsdOverlay" RowDefinitions="Auto, *, Auto" ZIndex="10" IsVisible="False">

            <!-- Top Navigation & Title Bar -->
            <Border Grid.Row="0" Padding="12,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#EE000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <Button Grid.Column="0" Click="OnBackClicked" Background="#77000000" BorderThickness="0" CornerRadius="18" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="ArrowLeft" Width="22" Height="22" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Volver" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Name="TitleLabel" Grid.Column="1" Text="" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                    <Border Grid.Column="2" Background="#44FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Name="QualityBadge" Text="Nativo" Foreground="#DDDDDD" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Button Grid.Column="3" Click="OnRotateClicked" Background="Transparent" BorderThickness="0" Padding="6,4" ToolTip.Tip="Rotar Pantalla">
                        <material:MaterialIcon Kind="ScreenRotation" Width="22" Height="22" Foreground="White" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Center Action Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28">
                <Button Click="OnRewindClicked" Background="#88000000" CornerRadius="26" Width="52" Height="52" BorderThickness="0">
                    <material:MaterialIcon Kind="Rewind10" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Name="CenterPlayPauseBtn" Click="OnPlayPauseClicked" Background="#AA000000" CornerRadius="32" Width="64" Height="64" BorderThickness="0">
                    <material:MaterialIcon Name="CenterPlayPauseIcon" Kind="Pause" Width="32" Height="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Click="OnForwardClicked" Background="#88000000" CornerRadius="26" Width="52" Height="52" BorderThickness="0">
                    <material:MaterialIcon Kind="FastForward10" Width="26" Height="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Bottom Control Bar -->
            <Border Grid.Row="2" Padding="12,8,12,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#EE000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="4">
                    <Grid Margin="0,0,0,2">
                        <Border Name="BufferProgressBg" Background="#33FFFFFF" CornerRadius="3" Height="4" VerticalAlignment="Center">
                            <Border Name="BufferProgressFill" Background="#7722DD88" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                        </Border>
                        <Slider Name="ProgressSlider" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" PointerCaptureLost="OnSliderPointerReleased" PointerPressed="OnSliderPointerPressed"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Name="TimeLabel" Text="0:00" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="/" Foreground="#777777" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Name="DurationLabel" Text="0:00" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#33FFFFFF" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="5" Height="5" Fill="#22DD88" VerticalAlignment="Center"/>
                                    <TextBlock Name="NetworkCacheLabel" Text="0.0s" Foreground="#AAAAAA" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ComboBox Name="SpeedCombo" Width="68" FontSize="11" SelectionChanged="OnSpeedChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                                <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                <ComboBoxItem Content="2.0x" Tag="2.0"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. Loading / Error Panel -->
        <Grid Name="LoadingPanel" Background="#F0000000" ZIndex="20" IsVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <TextBlock Name="StatusText" Text="Obteniendo enlace de video..." Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
                <TextBlock Name="SubtextLabel" Text="Por favor espera un momento..." Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center"/>
                <Button Name="RetryBtn" Content="Reintentar ahora" Click="OnRetryClicked" Background="{DynamicResource AppPrimaryColor}" Foreground="White" IsVisible="False" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
