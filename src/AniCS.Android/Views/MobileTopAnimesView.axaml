<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AniCS.Models;assembly=AniCS.Core"
             xmlns:converters="clr-namespace:AniCS.Desktop.Converters;assembly=AniCS.Desktop"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="700"
             x:Class="AniCS.Android.Views.MobileTopAnimesView">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <material:MaterialIcon Kind="Trophy" Width="22" Height="22" Foreground="{DynamicResource AppPrimaryColor}" VerticalAlignment="Center"/>
                <TextBlock Text="Top Animes Más Populares" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryColor}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Name="StatusText" Text="Cargando top animes..." FontSize="15" Foreground="{DynamicResource AppSubtextColor}" HorizontalAlignment="Center" Margin="0,20,0,0" IsVisible="True"/>

            <ItemsControl Name="TopAnimesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AnimeResult">
                        <Border Background="{DynamicResource AppCardBg}"
                                CornerRadius="10"
                                Padding="10"
                                ClipToBounds="True"
                                Margin="0,0,0,10"
                                Cursor="Hand"
                                Tapped="OnAnimeCardTapped">
                            <Grid ColumnDefinitions="70, *, Auto">
                                <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Width="70" Height="100" Background="#20FFFFFF">
                                    <Grid>
                                        <Image converters:AsyncImageLoader.SourceUrl="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                        <!-- Rank Badge -->
                                        <Border Background="#E53935" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" IsVisible="{Binding !!Rank}">
                                            <TextBlock Text="{Binding Rank, StringFormat='#{0}'}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryColor}" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource AppSubtextColor}"/>
                                    <!-- Votes -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0" IsVisible="{Binding Votes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <material:MaterialIcon Kind="ThumbUp" Width="12" Height="12" Foreground="{DynamicResource AppSubtextColor}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Votes}" FontSize="11" Foreground="{DynamicResource AppSubtextColor}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <material:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="24" Height="24" Foreground="{DynamicResource AppPrimaryColor}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
