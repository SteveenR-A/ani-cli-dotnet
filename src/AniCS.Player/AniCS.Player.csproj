<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- LibVLC — reproductor embebido (sin necesidad de VLC instalado) -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <!-- Control Avalonia para embeber el VideoView -->
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <!-- Avalonia base (mismo SDK que Desktop para compatibilidad) -->
    <PackageReference Include="Avalonia" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AniCS.Core\AniCS.Core.csproj" />
    <ProjectReference Include="..\AniCS.Resolver\AniCS.Resolver.csproj" />
  </ItemGroup>

</Project>
