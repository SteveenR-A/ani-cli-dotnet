<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AniCS.Models;assembly=AniCS.Core"
             xmlns:vm="clr-namespace:AniCS.Desktop.ViewModels"
             xmlns:controls="clr-namespace:AniCS.Desktop.Controls"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="AniCS.Desktop.Views.Paradigms.AndroidApp.AndroidAppView"
             x:DataType="vm:HomeViewModel">

    <!-- Root: contenido scrolleable de Inicio -->
    <Grid>

        <!-- ── Área de contenido ─────────────────────────────────────── -->
        <Grid RowDefinitions="Auto, Auto, *">

            <!-- Header: título + reload -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20,20,20,10">
                <TextBlock Grid.Column="0"
                           Text="AniCS"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource AppPrimaryColor}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Command="{Binding ReloadCommand}"
                        Background="Transparent"
                        Foreground="{DynamicResource AppTitleColor}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Recargar">
                    <material:MaterialIcon Kind="Refresh" Width="26" Height="26"/>
                </Button>
            </Grid>

            <!-- SearchBar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource AppSurfaceColor}"
                    CornerRadius="24"
                    Padding="14,0"
                    Margin="20,0,20,14"
                    Height="44">
                <Grid ColumnDefinitions="Auto, *">
                    <material:MaterialIcon Grid.Column="0"
                                          Kind="Magnify"
                                          Width="20" Height="20"
                                          Foreground="{DynamicResource AppSubtextColor}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Name="SearchBox"
                             PlaceholderText="Buscar anime..."
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             FontSize="14"
                             TextChanged="OnSearchTextChanged"/>
                </Grid>
            </Border>

            <!-- Carruseles -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,0">
                <StackPanel Spacing="28" Margin="0,0,0,16">

                    <!-- Estado de carga global -->
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="16"
                               Foreground="{DynamicResource AppSubtextColor}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               IsVisible="{Binding IsStatusVisible}"/>

                    <!-- Carrusel 1: Emisión Reciente -->
                    <StackPanel>
                        <Grid ColumnDefinitions="*, Auto" Margin="20,0,20,10">
                            <TextBlock Grid.Column="0"
                                       Text="Emisión Reciente"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AppTitleColor}"/>
                            <Button Grid.Column="1"
                                    Content="Ver más"
                                    Background="Transparent"
                                    Foreground="{DynamicResource AppPrimaryColor}"
                                    Click="OnSeeMoreLatestClicked"
                                    Cursor="Hand"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="20,0,0,0">
                            <ItemsControl Name="LatestItemsControl" ItemsSource="{Binding LatestList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AnimeResult">
                                        <controls:AnimeCardControl/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Carrusel 2: Estrenos / Destacados -->
                    <StackPanel IsVisible="{Binding HasPremieres}">
                        <Grid ColumnDefinitions="*, Auto" Margin="20,0,20,10">
                            <TextBlock Grid.Column="0"
                                       Text="Estrenos / Destacados"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AppTitleColor}"/>
                            <Button Grid.Column="1"
                                    Content="Ver más"
                                    Background="Transparent"
                                    Foreground="{DynamicResource AppPrimaryColor}"
                                    Click="OnSeeMorePremieresClicked"
                                    Cursor="Hand"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="20,0,0,0">
                            <ItemsControl Name="PremieresItemsControl" ItemsSource="{Binding PremieresList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AnimeResult">
                                        <controls:AnimeCardControl/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Carrusel 3: Seguir Viendo (Historial) -->
                    <StackPanel>
                        <Grid ColumnDefinitions="*, Auto" Margin="20,0,20,10">
                            <TextBlock Grid.Column="0"
                                       Text="Seguir Viendo"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AppTitleColor}"/>
                            <Button Grid.Column="1"
                                    Content="Ver más"
                                    Background="Transparent"
                                    Foreground="{DynamicResource AppPrimaryColor}"
                                    Click="OnSeeMoreHistoryClicked"
                                    Cursor="Hand"/>
                        </Grid>
                        <!-- Estado vacío de historial -->
                        <StackPanel Name="HistoryEmptyState"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0"
                                    Spacing="8"
                                    IsVisible="False">
                            <material:MaterialIcon Kind="PlayCircleOutline"
                                                   Width="48" Height="48"
                                                   Foreground="{DynamicResource AppSubtextColor}"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="Aún no has visto nada"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTitleColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Los episodios que reproduzcas aparecerán aquí"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppSubtextColor}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer Name="HistoryScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="20,0,0,0">
                            <ItemsControl ItemsSource="{Binding HistoryList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AnimeResult">
                                        <controls:AnimeCardControl/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
