<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AniCS.Desktop.Converters"
             xmlns:models="clr-namespace:AniCS.Models;assembly=AniCS.Core"
             xmlns:views="clr-namespace:AniCS.Desktop.Views"
             xmlns:local="clr-namespace:AniCS.Desktop"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:player="clr-namespace:AniCS.Player.Controls;assembly=AniCS.Player"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AniCS.Desktop.Views.AnimeDetailsView"
             x:DataType="models:AnimeResult">
    
    <UserControl.Resources>
        <converters:AsyncImageLoader x:Key="AsyncImageLoader"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *" Margin="20">
        <!-- Back Button -->
        <Button Grid.Row="0" Background="Transparent" Foreground="{DynamicResource AppPrimaryColor}" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Click="OnBackClicked">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <material:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
                <TextBlock Text="Volver" VerticalAlignment="Center" FontSize="16" />
            </StackPanel>
        </Button>

        <!-- Row 1: video embebido (si backend = LibVLC) + contenido normal -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *">

            <!-- Contenido original (ScrollViewer) -->
            <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- Title -->
                <SelectableTextBlock Name="TitleText" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AppTitleColor}" TextWrapping="Wrap" Margin="0,0,0,15" />

                <!-- Header Content (Responsive for mobile & desktop) -->
                <Grid Name="HeaderGrid" ColumnDefinitions="Auto, *" Margin="0,0,0,20">
                    <!-- Left: Cover & Info Card -->
                    <StackPanel Name="LeftPanel" Grid.Column="0" Spacing="15" Margin="0,0,20,15" Width="280">
                        <Border CornerRadius="8" ClipToBounds="True" Width="240" Height="340" HorizontalAlignment="Center" Background="{DynamicResource AppSurfaceColor}">
                            <Image Name="CoverImage"
                                   converters:AsyncImageLoader.SourceUrl="{Binding ThumbnailUrl}"
                                   Stretch="Uniform" />
                        </Border>
                        
                        <!-- Metadata Card -->
                        <Border Background="{DynamicResource AppSurfaceColor}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="INFORMACIÓN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4"/>
                                
                                <StackPanel IsVisible="{Binding Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Tipo:" FontSize="11" Foreground="{DynamicResource AppTextColor}" />
                                    <TextBlock Text="{Binding Type}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleColor}" />
                                </StackPanel>
                                
                                <StackPanel IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Estado:" FontSize="11" Foreground="{DynamicResource AppTextColor}" />
                                    <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleColor}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding Studios, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Studios:" FontSize="11" Foreground="{DynamicResource AppTextColor}" />
                                    <TextBlock Text="{Binding Studios}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleColor}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding TotalEpisodes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Episodios:" FontSize="11" Foreground="{DynamicResource AppTextColor}" />
                                    <TextBlock Text="{Binding TotalEpisodes}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleColor}" />
                                </StackPanel>
                                
                                <StackPanel IsVisible="{Binding Season, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Temporada:" FontSize="11" Foreground="{DynamicResource AppTextColor}" />
                                    <TextBlock Text="{Binding Season}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleColor}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding Duration, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Duración:" FontSize="11" Foreground="{DynamicResource AppTextColor}" />
                                    <TextBlock Text="{Binding Duration}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleColor}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding Broadcast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Emitido:" FontSize="11" Foreground="{DynamicResource AppTextColor}" />
                                    <TextBlock Text="{Binding Broadcast}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleColor}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding Demography, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Demografía:" FontSize="11" Foreground="{DynamicResource AppTextColor}" />
                                    <TextBlock Text="{Binding Demography}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTitleColor}" />
                                </StackPanel>

                                <!-- Géneros Badge List -->
                                <StackPanel IsVisible="{Binding !!Genres.Count}" Margin="0,5,0,0">
                                    <TextBlock Text="Géneros:" FontSize="11" Foreground="{DynamicResource AppTextColor}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Genres}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppSurfaceColor}" BorderThickness="1" BorderBrush="{DynamicResource AppPrimaryColor}" CornerRadius="12" Padding="8,3" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AppPrimaryColor}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Right: Opening & Synopsis Cards -->
                    <StackPanel Name="RightPanel" Grid.Column="1" Spacing="15" HorizontalAlignment="Stretch">
                        <!-- Opening / Trailer Card -->
                        <Border Name="OpeningCard" IsVisible="{Binding OpeningUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Background="{DynamicResource AppSurfaceColor}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource AppPrimaryColor}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="Music" Width="20" Height="20" Foreground="{DynamicResource AppPrimaryColor}" />
                                    <TextBlock Text="OPENING / TRAILER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryColor}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Escucha el audio en la app, míralo directamente en YouTube o descárgalo." FontSize="12" Foreground="{DynamicResource AppTextColor}" TextWrapping="Wrap" />
                                
                                <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Name="PlayAudioBtn" Click="OnPlayOpeningAudioClicked" Background="{DynamicResource AppPrimaryColor}" Foreground="{DynamicResource AppPrimaryForegroundColor}" Padding="10,8" Margin="0,0,6,6" ToolTip.Tip="Reproducir solo audio en la app">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <material:MaterialIcon Name="PlayAudioBtnIcon" Kind="VolumeHigh" Width="16" Height="16" />
                                            <TextBlock Name="PlayAudioBtnText" Text="Audio en App" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="OnOpenOpeningInBrowserClicked" Background="{DynamicResource AppStatusInProgressColor}" Foreground="{DynamicResource AppPrimaryForegroundColor}" Padding="10,8" Margin="0,0,6,6" ToolTip.Tip="Abrir directamente en YouTube">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <material:MaterialIcon Kind="Youtube" Width="16" Height="16" />
                                            <TextBlock Text="Ver en YouTube" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Name="DownloadOpeningBtn" Click="OnDownloadOpeningClicked" Background="{DynamicResource AppStatusCompletedColor}" Foreground="{DynamicResource AppPrimaryForegroundColor}" Padding="10,8" Margin="0,0,6,6" ToolTip.Tip="Descargar archivo en máxima calidad">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <material:MaterialIcon Name="DownloadOpeningBtnIcon" Kind="Download" Width="16" Height="16" />
                                            <TextBlock Name="DownloadOpeningBtnText" Text="Descargar" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Name="CancelOpeningDownloadBtn" IsVisible="False" Click="OnCancelOpeningDownloadClicked" Background="{DynamicResource AppDangerColor}" Foreground="{DynamicResource AppDangerForegroundColor}" Padding="8" Margin="0,0,6,6" ToolTip.Tip="Cancelar descarga">
                                        <material:MaterialIcon Kind="Close" Width="16" Height="16" />
                                    </Button>
                                    <Button Name="DeleteOpeningDownloadBtn" IsVisible="False" Click="OnDeleteOpeningDownloadClicked" Background="{DynamicResource AppDangerColor}" Foreground="{DynamicResource AppDangerForegroundColor}" Padding="8" Margin="0,0,6,6" ToolTip.Tip="Eliminar descarga de Opening">
                                        <material:MaterialIcon Kind="TrashCan" Width="16" Height="16" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Synopsis Card -->
                        <Border Background="{DynamicResource AppSurfaceColor}" CornerRadius="8" Padding="15" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock Text="SINOPSIS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryColor}" />
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <SelectableTextBlock Name="SynopsisText" FontSize="14" Foreground="{DynamicResource AppTextColor}" TextWrapping="Wrap" Text="Cargando sinopsis..." LineHeight="20" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                
                <!-- Episodes List -->
                <StackPanel>
                    <TextBlock Name="StatusText" Text="Cargando episodios..." FontSize="18" Foreground="{DynamicResource AppTextColor}" HorizontalAlignment="Center" Margin="0,0,0,15" IsVisible="True" TextWrapping="Wrap"/>
                    <ItemsControl Name="EpisodesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:EpisodeViewModel">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                                    <Button Grid.Column="0" Background="{DynamicResource AppSurfaceColor}" 
                                            CornerRadius="4,0,0,4" 
                                            Padding="15,10" 
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnEpisodeClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding WatchStatusIcon}" ToolTip.Tip="{Binding WatchStatusTip}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EpisodeNumber}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryColor}" Width="40"/>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AppTitleColor}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Grid Grid.Column="1" ColumnDefinitions="*, Auto, Auto" IsVisible="{Binding IsDownloadButtonVisible}">
                                        <Button Grid.Column="0" Background="{DynamicResource AppSurfaceColor}" 
                                                CornerRadius="0,4,4,0" 
                                                Padding="15,10" 
                                                IsEnabled="{Binding CanDownload}"
                                                Click="OnDownloadEpisodeClicked">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <material:MaterialIcon Kind="{Binding DownloadIcon}" Width="16" Height="16" />
                                                <TextBlock Text="{Binding DownloadText}" Foreground="{DynamicResource AppTitleColor}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" IsVisible="{Binding IsDownloading}"
                                                Click="OnCancelDownloadClicked"
                                                Background="{DynamicResource AppDangerColor}" Foreground="{DynamicResource AppDangerForegroundColor}"
                                                ToolTip.Tip="Cancelar descarga"
                                                Margin="5,0,0,0">
                                            <material:MaterialIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                        <Button Grid.Column="2" IsVisible="{Binding IsDownloaded}"
                                                Click="OnDeleteDownloadedEpisodeClicked"
                                                Background="{DynamicResource AppDangerColor}" Foreground="{DynamicResource AppDangerForegroundColor}"
                                                ToolTip.Tip="Eliminar episodio descargado"
                                                Margin="5,0,0,0">
                                            <material:MaterialIcon Kind="TrashCan" Width="16" Height="16" />
                                        </Button>
                                    </Grid>

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        </Grid><!-- fin Grid Row=1 -->
    </Grid>
</UserControl>
