<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="AniCS" Manufacturer="SteveenR-A" Version="1.6.2" UpgradeCode="a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d" Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Ya tienes instalada una versión más reciente de AniCS." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="src\AniCS.Desktop\Assets\Incono\favicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <Feature Id="Main">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentGroupRef Id="ExternalComponents" />
      <ComponentGroupRef Id="EnvComponents" />
      <ComponentGroupRef Id="ShortcutsComponents" />
    </Feature>
  </Package>
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AniCS" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AniCS" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>
  <Fragment>
    <ComponentGroup Id="ExternalComponents" Directory="INSTALLFOLDER">
      <?if $(var.BundleExternals) = "1" ?>
      <Component Id="YTDLPEXE" Guid="*">
        <File Id="YTDLPEXE" Source="InstallerDependencies\yt-dlp.exe" KeyPath="yes" />
      </Component>
      <Component Id="MPVEXE" Guid="*">
        <File Id="MPVEXE" Source="InstallerDependencies\mpv.exe" KeyPath="yes" />
      </Component>
      <Component Id="MPVD3D" Guid="*">
        <File Id="MPVD3D" Source="InstallerDependencies\d3dcompiler_43.dll" KeyPath="yes" />
      </Component>
      <?endif?>
    </ComponentGroup>
    <ComponentGroup Id="EnvComponents" Directory="INSTALLFOLDER">
      <Component Id="PathEnv" Guid="6a7b8c9d-1e2f-4a3b-5c6d-7e8f9a0b1c2d">
        <RegistryValue Root="HKCU" Key="Software\SteveenR-A\AniCS" Name="path_installed" Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="UpdatePath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="ShortcutsComponents" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="7b8a9c1d-2e3f-4a5b-6c7d-8e9f0a1b2c3d">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="AniCS" Description="Aplicación AniCS" Target="[#AniCSEXE]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="ApplicationDesktopShortcut" Directory="DesktopFolder" Name="AniCS" Description="Aplicación AniCS" Target="[#AniCSEXE]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SteveenR-A\AniCS" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>